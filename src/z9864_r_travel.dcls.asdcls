@EndUserText.label: 'Acces control for travels'
@MappingRole: true
define role Z9864_R_TRAVEL {
    grant 
        select
            on
                Z9864_R_Travel
                    where
                        (AgencyId) = aspect pfcg_auth( 
                                              /LRN/AGCY,
                                              /LRN/AGCY,
                                              ACTVT = '03' );
                        
}